# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Конфиги ядер генерируются на лету и содержат UUID/пароли из подписки —
# в историю их пускать нельзя. Рабочие копии лежат рядом с .exe (в /build/,
# он и так игнорируется), а эти — следы CLI-отладки в корне.
/config.json
/xray_config.json
/xray_bridge_*.json
/*_probe.json

# Наборы правил (.srs) качаются при первом включении раздельного
# туннелирования, это кэш, а не исходник.
/rulesets/

# Лог приложения — перезаписывается при каждом запуске.
app_log.txt

# Локальные заметки с секретами (ссылка на подписку и т.п.).
*.local.md

# Ядра НЕ храним в репозитории: это чужие сборки (SagerNet/sing-box, XTLS/Xray-core),
# вместе они весят под 90 МБ, sing-box один превышает мягкий лимит GitHub в 50 МБ,
# а в самосборном бинарнике ещё и путь сборки с именем пользователя.
# Их скачивает само приложение (автообновление ядер) либо кладут руками — см. README.
/sing-box.exe
/xray.exe

# Рабочие файлы приложения рядом с .exe: конфиги содержат реальные адреса
# серверов и UUID из подписки, лог — историю соединений.
config.json
xray_config.json
xray_bridge_*.json
*_probe.json
app_log.txt*
rulesets/
update_staging/
backup_*/
